---
layout: layouts/base.njk
permalink: /book.html
title: Book a reading | Connor Boyd, Spiritual Medium
description: Book a 1-2-1, video or house-party reading with Connor Boyd, spiritual medium.
nav: book
---
{% import "partials/macros.njk" as m with context %}
{% set readings = events.events | upcoming("reading") %}

<header class="page-head">
  <div class="container">
    {{ m.flipCard("key", "", "page-head__card") }}
    <h1>Book a reading</h1>
    <p>{{ bookpage.intro }}</p>
  </div>
</header>

<section class="section" id="choose" aria-labelledby="choose-title">
  <div class="container">
    <div class="section__head">
      <h2 id="choose-title">Choose your reading</h2>
    </div>
    <div class="readings">
      <article class="reading reading--span">
        <h3>1-2-1 reading</h3>
        <div>
          <p class="reading__price"><span>{{ home.readings_duration }}</span><span>{{ home.readings_price }}</span></p>
          <p>{{ bookpage.readings_text }}</p>
          {{ m.weekendList(readings) }}
        </div>
        <div class="event__actions">
          <a class="btn btn--gold" href="{{ m.whatsappGeneral() }}" target="_blank" rel="noopener">{{ m.icon("whatsapp") }} WhatsApp to reserve a slot</a>
        </div>
      </article>
      <article class="reading">
        <h3>Video reading</h3>
        <div>
          <p class="reading__price"><span>{{ home.video_duration }}</span><span>{{ home.video_price }}</span><span>From your own home</span></p>
          <p>{{ bookpage.video_text }}</p>
        </div>
        <a class="btn btn--gold" href="#calendar" data-terms-open>{{ m.icon("calendar") }} Choose a time</a>
      </article>
      <article class="reading">
        <h3>Spiritual house party</h3>
        <div>
          <p class="reading__price"><span>At your home</span><span>Price on request</span></p>
          <p>{{ bookpage.house_party_text }}</p>
        </div>
        <a class="btn btn--ghost" href="mailto:{{ settings.email }}?subject=House%20party%20enquiry">{{ m.icon("mail") }} Ask about a date</a>
      </article>
    </div>
    <p class="calendar__alt">Questions first? Message <a href="https://wa.me/{{ settings.whatsapp_username }}" target="_blank" rel="noopener">{{ settings.whatsapp_username }}</a> on WhatsApp, or email <a href="mailto:{{ settings.email }}">{{ settings.email }}</a>.</p>
  </div>
</section>

<section class="section section--glow" id="calendar" aria-labelledby="calendar-title">
  <div class="container">
    <div class="section__head">
      <h2 id="calendar-title">Book a video reading</h2>
      <p class="section__intro">{{ bookpage.calendar_intro }}</p>
    </div>
    {# Calendly loads here only after the visitor agrees to the terms #}
    <div class="calendar-gate" data-calendly-gate data-url="{{ settings.calendly_url }}?primary_color=1c2f29&hide_gdpr_banner=1">
      <p>Have a quick read of what to expect, then choose a day and time.</p>
      <button class="btn btn--gold" type="button" data-terms-open>{{ m.icon("calendar") }} Choose a time</button>
      <noscript><p>Booking needs JavaScript. You can also <a href="{{ settings.calendly_url }}">open the booking page</a>.</p></noscript>
    </div>
    <p class="calendar__alt">Calendar not loading? <a href="{{ settings.calendly_url }}" target="_blank" rel="noopener" data-terms>Open it in a new tab</a>. {{ bookpage.notice }}</p>
  </div>
</section>
