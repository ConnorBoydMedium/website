// Cloudflare Worker settings. Cloudflare builds the site with "npm run build"
// into _site, then serves it; worker/index.js adds the live /api/video-days feed.
{
  "name": "website",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
